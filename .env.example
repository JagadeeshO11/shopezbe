PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=shopez
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CLIENT_URL=http://localhost:3000

# Email OTP delivery (Resend). Leave blank until configured for local testing.
RESEND_API_KEY=
EMAIL_FROM=

# Google Identity Services client ID (same public client ID used by frontend).
GOOGLE_CLIENT_ID=
